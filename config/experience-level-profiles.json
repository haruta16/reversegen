        "color": { "mode": "range", "min": 0.3, "max": 0.4, "jitter": 0 },
        "spread": { "mode": "random_range", "min": 0.0, "max": 0.33 },
        "debt": { "mode": "random_range", "min": 0.0, "max": 0.33 },
        "color_allocation": { "mode": "balanced" }
