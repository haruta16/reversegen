{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reversegen.local/schema/strategy-v2.json",
  "title": "ReverseGen batch strategy v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "scope", "target", "generator", "pipeline", "runtime", "output"],
  "properties": {
    "schema_version": {"const": 2},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "description": {"type": "string"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["levels_dir", "levels"],
      "properties": {
        "levels_dir": {"type": "string", "minLength": 1},
        "levels": {"type": "array", "minItems": 1, "items": {"type": ["integer", "string"]}},
        "exclude_levels": {"type": "array", "items": {"type": ["integer", "string"]}}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grades", "count_per_grade", "max_attempts_per_level"],
      "properties": {
        "grades": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
        "count_per_grade": {"type": "integer", "minimum": 1},
        "max_attempts_per_level": {"type": "integer", "minimum": 1}
      }
    },
    "generator": {"$ref": "#/$defs/layerClosureGenerator"},
    "pipeline": {"type": "array", "minItems": 1, "items": {"oneOf": [{"$ref": "#/$defs/simulate"}, {"$ref": "#/$defs/grade"}, {"$ref": "#/$defs/filter"}]}},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed", "concurrency", "trace"],
      "properties": {
        "seed": {"type": "integer"},
        "concurrency": {"oneOf": [{"const": "auto"}, {"type": "integer", "minimum": 1}]},
        "trace": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "sample_rate"],
          "properties": {"enabled": {"type": "boolean"}, "sample_rate": {"type": "number", "minimum": 0, "maximum": 1}}
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format"],
      "properties": {"format": {"const": "jsonl"}}
    }
  },
  "$defs": {
    "range": {
      "type": "object", "additionalProperties": false, "required": ["kind", "min", "max"],
      "properties": {"kind": {"const": "range"}, "min": {"type": "number"}, "max": {"type": "number"}}
    },
    "layerClosureGenerator": {
      "type": "object", "additionalProperties": false, "required": ["method", "version", "parameters"],
      "properties": {
        "method": {"const": "layer_closure"}, "version": {"const": 1},
        "parameters": {
          "type": "object", "additionalProperties": false,
          "required": ["close_rates", "color_count", "spread", "debt", "color_allocation"],
          "properties": {
            "close_rates": {"oneOf": [
              {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "random"}}},
              {"$ref": "#/$defs/range"},
              {"type": "object", "additionalProperties": false, "required": ["kind", "values"], "properties": {"kind": {"const": "fixed"}, "values": {"type": "array", "items": {"type": "number"}}}}
            ]},
            "color_count": {"oneOf": [
              {"type": "object", "additionalProperties": false, "required": ["kind", "min", "max"], "properties": {"kind": {"const": "ratio_range"}, "min": {"type": "number"}, "max": {"type": "number"}, "jitter": {"type": "integer", "minimum": 0}}},
              {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "fixed"}, "value": {"type": "integer", "minimum": 1}}}
            ]},
            "spread": {"oneOf": [{"$ref": "#/$defs/range"}, {"$ref": "#/$defs/fixedNumber"}]},
            "debt": {"oneOf": [{"$ref": "#/$defs/range"}, {"$ref": "#/$defs/fixedNumber"}]},
            "color_allocation": {"oneOf": [
              {"type": "object", "additionalProperties": false, "required": ["mode"], "properties": {"mode": {"const": "balanced"}}},
              {"type": "object", "additionalProperties": false, "required": ["mode"], "properties": {"mode": {"const": "single_heavy"}, "max_ratio": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}}}
            ]}
          }
        }
      }
    },
    "fixedNumber": {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "fixed"}, "value": {"type": "number"}}},
    "policy": {
      "type": "object", "additionalProperties": false, "required": ["id", "version", "config"],
      "properties": {"id": {"enum": ["mistake_player", "shortest_current_state"]}, "version": {"const": 1}, "config": {"type": "object"}}
    },
    "simulate": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "engine", "policy", "runs"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "type": {"const": "simulate"}, "engine": {"enum": ["typescript", "rust"]},
        "policy": {"$ref": "#/$defs/policy"}, "runs": {"type": "integer", "minimum": 1}, "max_steps": {"type": "integer", "minimum": 1},
        "variants": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "config"], "properties": {"id": {"type": "string", "minLength": 1}, "config": {"type": "object"}}}}
      }
    },
    "grade": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "method", "source", "inputs"],
      "properties": {"id": {"type": "string", "minLength": 1}, "type": {"const": "grade"}, "method": {"const": "strategy2"}, "source": {"type": "string"}, "inputs": {"type": "object", "additionalProperties": false, "required": ["sim1", "sim5", "sim15"], "properties": {"sim1": {"type": "string"}, "sim5": {"type": "string"}, "sim15": {"type": "string"}}}}
    },
    "constraint": {"type": "object", "additionalProperties": false, "properties": {"min": {"type": "number"}, "min_exclusive": {"type": "number"}, "max": {"type": "number"}, "max_exclusive": {"type": "number"}}},
    "filter": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "method", "source", "grade_source", "constraints"],
      "properties": {"id": {"type": "string", "minLength": 1}, "type": {"const": "filter"}, "method": {"const": "grade_metric_constraints"}, "source": {"type": "string"}, "grade_source": {"type": "string"}, "constraints": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": {"$ref": "#/$defs/constraint"}}}}
    }
  }
}
