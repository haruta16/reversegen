{
  "name": "reversegen",
  "version": "1.0.0",
  "description": "Standalone ReverseGen board generation algorithm and ReplayCode serializer, decoupled from Unity",
  "type": "module",
  "main": "./src/index.ts",
  "bin": {
    "reversegen": "./cli/generate.ts"
  },
  "scripts": {
    "generate": "npx tsx cli/generate.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npx tsx --test test/unit/*.test.ts test/integration/*.test.ts",
    "test:algo": "npx tsx --test test/unit/reverse-gen.test.ts",
    "test:serializer": "npx tsx --test test/unit/serializer.test.ts",
    "gui": "npx tsx gui/server.ts ",
    "strategy:validate": "npx tsx tools/run-strategy.ts --validate",
    "strategy:plan": "npx tsx tools/run-strategy.ts",
    "strategy:run": "npx tsx tools/run-strategy.ts --run",
    "strategy:rust:build": "cargo build --release --manifest-path rust/strategy-sim/Cargo.toml",
    "replay:check": "npx tsx cli/replay-selection.ts check",
    "replay:build": "npx tsx cli/replay-selection.ts build"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
